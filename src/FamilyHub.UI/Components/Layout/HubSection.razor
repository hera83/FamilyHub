@namespace FamilyHub.UI.Components

@* A titled group of content on a page. Pages are built from sections; sections from cards, lists and fields. *@
<section class="hub-section @Class">
    @if (Title is not null || Actions is not null)
    {
        <header class="hub-section__header">
            <div class="hub-section__heading">
                @if (Title is not null)
                {
                    <h2 class="hub-section__title">@Title</h2>
                }
                @if (Description is not null)
                {
                    <p class="hub-section__description">@Description</p>
                }
            </div>
            @if (Actions is not null)
            {
                <div class="hub-section__actions">@Actions</div>
            }
        </header>
    }
    @ChildContent
</section>

@code {
    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Class { get; set; }
}
