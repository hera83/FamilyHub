@inject CalendarService Calendar
@inject IHubClock Clock

@*
    "Tilføj aftale" and "Ret aftale": only the title is typed. Calendar, day and time are picked with chips and steppers,
    so the keyboard is only up while the title is written. When editing, the calendar stays (moving an appointment to
    another calendar is done in Google), and location, description and guests are left as they are in Google.
*@
<HubDialog Open="Open" OpenChanged="OpenChanged" Title="@(Event is null ? "Tilføj aftale" : "Ret aftale")" CloseOnBackdrop="false">
    <ChildContent>
        <HubTextField Label="Titel" Placeholder="Fx Tandlæge" Kind="InputKind.Text" AutoFocus="@(Event is null)"
                      MaxLength="CalendarEvent.MaxTitleLength" Error="@titleError" @bind-Value="title" />

        @if (Event is { IsRecurring: true })
        {
            <p class="hub-muted">Aftalen gentages. Ændringen gælder kun denne gang.</p>
        }
        else if (Event is null && Calendars.Count > 1)
        {
            <HubChoice TValue="string" Label="Kalender" Appearance="ChoiceAppearance.Chips" Options="calendarOptions" @bind-Value="calendarId" />
        }
        else if (Event is null && Calendars.Count == 1)
        {
            <p class="hub-muted">Tilføjes i @ChoiceLabel(Calendars[0]).</p>
        }

        <NumberStepper TValue="int" Label="Dag" @bind-Value="dayOffset" Min="minDayOffset" Max="maxDayOffset"
                       Format="DayText" Help="@DanishFormat.LongDate(today.AddDays(dayOffset))"
                       DecreaseLabel="Dagen før" IncreaseLabel="Dagen efter" />
        <HubSwitch Label="Hele dagen" @bind-Value="allDay" />

        @if (allDay)
        {
            <NumberStepper TValue="int" Label="Antal dage" @bind-Value="days" Min="1" Max="maxDays"
                           Format="@(d => d == 1 ? "1 dag" : $"{d} dage")" DecreaseLabel="Færre dage" IncreaseLabel="Flere dage" />
        }
        else
        {
            <NumberStepper TValue="int" Label="Starter" @bind-Value="startMinutes" Min="0" Max="lastStart" Step="15"
                           Format="ClockText" DecreaseLabel="Tidligere" IncreaseLabel="Senere" Help="@EndsText" />
            <HubChoice TValue="int" Label="Varighed" Appearance="ChoiceAppearance.Chips" Options="durationOptions" @bind-Value="durationMinutes" />
        }
    </ChildContent>
    <Footer>
        <HubButton Variant="ButtonVariant.Quiet" OnClick="CloseAsync">Annuller</HubButton>
        @if (Event is { } original)
        {
            <HubButton Variant="ButtonVariant.Primary" Icon="IconName.Check" OnClick="() => SaveAsync(original)" ErrorMessage="Aftalen blev ikke gemt">Gem</HubButton>
        }
        else
        {
            <HubButton Variant="ButtonVariant.Primary" Icon="IconName.Plus" OnClick="AddAsync" ErrorMessage="Aftalen blev ikke tilføjet">Tilføj</HubButton>
        }
    </Footer>
</HubDialog>

@code {
    private const int MaxDaysAhead = 400;
    private const int MaxDays = 14;

    // A past appointment may still be moved a bit further back, e.g. to note when something really happened.
    private const int DaysBackWhenEditing = 31;
    private const int LastStart = 23 * 60 + 45;

    private static readonly int[] Durations = [15, 30, 60, 90, 120, 180];

    private bool wasOpen;
    private DateOnly today;
    private string title = "";
    private string? titleError;
    private string calendarId = "";
    private IReadOnlyList<ChoiceOption<string>> calendarOptions = [];
    private IReadOnlyList<ChoiceOption<int>> durationOptions = [];
    private int dayOffset;
    private int minDayOffset;
    private int maxDayOffset;
    private bool allDay;
    private int days = 1;
    private int maxDays = MaxDays;
    private int startMinutes;
    private int lastStart = LastStart;
    private int durationMinutes = 60;

    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>The appointment to change – null to add a new one.</summary>
    [Parameter]
    public CalendarEvent? Event { get; set; }

    /// <summary>Calendars that may get new appointments.</summary>
    [Parameter]
    public IReadOnlyList<CalendarEntry> Calendars { get; set; } = [];

    /// <summary>Suggested day – the day the user is looking at.</summary>
    [Parameter]
    public DateOnly InitialDate { get; set; }

    /// <summary>Suggested calendar, e.g. the family member the view is filtered on.</summary>
    [Parameter]
    public string? InitialCalendarId { get; set; }

    [Parameter]
    public EventCallback<CalendarEvent> OnAdded { get; set; }

    [Parameter]
    public EventCallback<CalendarEvent> OnSaved { get; set; }

    private string EndsText
    {
        get
        {
            var end = startMinutes + durationMinutes;
            var text = $"Slutter {ClockText(end % CalendarLayout.MinutesPerDay)}";
            return end switch
            {
                >= 2 * CalendarLayout.MinutesPerDay => $"{text} {DanishFormat.LongDate(today.AddDays(dayOffset + end / CalendarLayout.MinutesPerDay)).ToLower(DanishFormat.Culture)}",
                >= CalendarLayout.MinutesPerDay => $"{text} dagen efter",
                _ => text,
            };
        }
    }

    protected override void OnParametersSet()
    {
        // Fresh form every time the dialog opens.
        if (Open && !wasOpen)
        {
            Reset();
        }

        wasOpen = Open;
    }

    private void Reset()
    {
        today = Clock.Today;
        titleError = null;
        if (Event is { } e)
        {
            FillFrom(e);
            return;
        }

        title = "";
        allDay = false;
        days = 1;
        maxDays = MaxDays;
        durationMinutes = 60;
        durationOptions = DurationChoices(durationMinutes);
        minDayOffset = 0;
        maxDayOffset = MaxDaysAhead;
        dayOffset = Math.Clamp(InitialDate.DayNumber - today.DayNumber, 0, MaxDaysAhead);
        lastStart = LastStart;

        // Today: the next whole hour. Another day: 10:00.
        var now = Clock.Now;
        startMinutes = dayOffset == 0 ? Math.Min((now.Hour + 1) * 60, 23 * 60) : 10 * 60;

        calendarOptions = [.. Calendars.Select(c => new ChoiceOption<string>(c.Id, ChoiceLabel(c)))];
        calendarId = Calendars.FirstOrDefault(c => c.Id == InitialCalendarId)?.Id
            ?? Calendars.FirstOrDefault(c => c.Source.IsPrimary)?.Id
            ?? Calendars.FirstOrDefault()?.Id
            ?? "";
    }

    // The form starts as the appointment is. A time that doesn't fit the steps (10:10, 45 min) is kept as it is.
    private void FillFrom(CalendarEvent e)
    {
        title = e.Title;
        calendarId = e.CalendarId;
        allDay = e.IsAllDay;
        dayOffset = e.StartDate.DayNumber - today.DayNumber;
        minDayOffset = Math.Min(0, dayOffset - DaysBackWhenEditing);
        maxDayOffset = Math.Max(MaxDaysAhead, dayOffset);

        days = allDay ? Math.Max(1, e.EndDate.DayNumber - e.StartDate.DayNumber) : 1;
        maxDays = Math.Max(MaxDays, days);

        startMinutes = allDay ? 10 * 60 : e.Start.Hour * 60 + e.Start.Minute;
        lastStart = Math.Max(LastStart, startMinutes);
        durationMinutes = allDay ? 60 : Math.Max(0, (int)Math.Round((e.End - e.Start).TotalMinutes));
        durationOptions = DurationChoices(durationMinutes);
    }

    private static IReadOnlyList<ChoiceOption<int>> DurationChoices(int current) =>
        [.. Durations.Append(current).Distinct().Order().Select(m => new ChoiceOption<int>(m, DanishFormat.Duration(TimeSpan.FromMinutes(m))))];

    // Short in the stepper ("I dag", "Man. 28. sep."); the full date is written under it.
    private string DayText(int offset) => DanishFormat.RelativeDay(today.AddDays(offset), today);

    // A family member's only calendar is simply called by their name ("Mette" rather than "mette@gmail.com").
    private string ChoiceLabel(CalendarEntry calendar) =>
        calendar.Member is { } member && Calendars.Count(c => c.Member?.Id == member.Id) == 1 ? member.Name : calendar.Name;

    private static string ClockText(int minutes) => $"{minutes / 60:00}:{minutes % 60:00}";

    private CalendarEventDraft? Draft()
    {
        if (string.IsNullOrWhiteSpace(title))
        {
            titleError = "Skriv en titel";
            return null;
        }

        titleError = null;
        return new CalendarEventDraft
        {
            CalendarId = calendarId,
            Title = title.Trim(),
            Date = today.AddDays(dayOffset),
            IsAllDay = allDay,
            StartTime = TimeOnly.FromTimeSpan(TimeSpan.FromMinutes(startMinutes)),
            Duration = TimeSpan.FromMinutes(durationMinutes),
            Days = days,
        };
    }

    private async Task AddAsync()
    {
        if (Draft() is not { } draft)
        {
            return;
        }

        var created = await Calendar.AddEventAsync(draft);
        await CloseAsync();
        await OnAdded.InvokeAsync(created);
    }

    private async Task SaveAsync(CalendarEvent original)
    {
        if (Draft() is not { } draft)
        {
            return;
        }

        var saved = await Calendar.UpdateEventAsync(original, draft);
        await CloseAsync();
        await OnSaved.InvokeAsync(saved);
    }

    private async Task CloseAsync()
    {
        Open = false;
        wasOpen = false;
        await OpenChanged.InvokeAsync(false);
    }
}
