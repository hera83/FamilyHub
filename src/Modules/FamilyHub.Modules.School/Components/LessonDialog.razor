@*
    One lesson on one day, opened by tapping it on the school page. From the school's calendar: when, where, what it is
    about, the course and the teachers. From the fixed timetable: the subject, its time and the timetable's note.
    Both kinds get a note for that day only and "Skjul" (e.g. a cancelled lesson) – the same in both, so the page works
    alike with and without a link. A calendar cell with several lessons ("+1 mere") shows them all, each with its own.
*@
@inject SchoolScheduleService School
@inject IToastService Toasts
@inject IHubClock Clock
@inject ILogger<LessonDialog> Logger

<HubDialog Open="entries.Count > 0" OpenChanged="OnOpenChanged" Title="@Title" Size="DialogSize.Medium" CloseOnBackdrop="!IsDirty">
    <ChildContent>
        <div class="sl-lessons">
            @for (var i = 0; i < entries.Count; i++)
            {
                var index = i;
                var entry = entries[index];
                <section class="sl-lesson">
                    @if (entries.Count > 1)
                    {
                        <h3 class="sl-lesson__title">@entry.Target.Title</h3>
                    }

                    @if (entry.Calendar?.Change is { } change)
                    {
                        <InfoBox Tone="HubTone.Warning" Icon="IconName.AlertTriangle" Title="@FeedChanges.Label(change.Kind)">
                            @FeedChanges.Describe(change)
                        </InfoBox>
                    }

                    <p class="sl-row">
                        <Icon Name="IconName.Clock" />
                        <span class="hub-numeric">@When(entry.Target)</span>
                    </p>
                    @if (entry.Calendar?.Lesson is { } lesson)
                    {
                        @if (lesson.Location is { } location)
                        {
                            <p class="sl-row">
                                <Icon Name="IconName.MapPin" />
                                <span>@location</span>
                            </p>
                        }
                        @foreach (var section in LessonDetails.Sections(lesson.Description))
                        {
                            <div class="sl-row">
                                <Icon Name="IconFor(section)" />
                                <div class="sl-row__text">
                                    <span class="sl-row__label">@(section.Label ?? "Om timen")</span>
                                    @foreach (var line in section.Lines)
                                    {
                                        <span>@line</span>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else if (entry.TimetableNote is { } timetableNote)
                    {
                        <div class="sl-row">
                            <Icon Name="IconName.Info" />
                            <div class="sl-row__text">
                                <span class="sl-row__label">Note i skemaet</span>
                                <span>@timetableNote</span>
                            </div>
                        </div>
                    }

                    <HubTextField Label="Note" Kind="InputKind.Text" Placeholder="Fx Husk madpakke" MaxLength="LessonAdjustment.MaxNoteLength"
                                  Help="@($"Vises under timen – kun {DayText(entry.Target)}.")" @bind-Value="notes[index]" OnEnter="EnterAsync" />

                    @if (entries.Count > 1)
                    {
                        <div class="sl-lesson__hide">
                            <HubButton Icon="IconName.EyeOff" OnClick="() => HideAsync(entry, index)" ErrorMessage="Timen blev ikke skjult"
                                       AriaLabel="@($"Skjul {entry.Target.Title}")">Skjul</HubButton>
                        </div>
                    }
                </section>
            }
        </div>
    </ChildContent>
    <Footer>
        @if (entries is [var only])
        {
            <div class="sl-footer__hide">
                <HubButton Icon="IconName.EyeOff" OnClick="() => HideAsync(only, 0)" ErrorMessage="Timen blev ikke skjult">Skjul</HubButton>
            </div>
        }
        <HubButton Variant="ButtonVariant.Quiet" OnClick="CloseAsync">@(IsDirty ? "Annuller" : "Luk")</HubButton>
        @if (IsDirty)
        {
            <HubButton Variant="ButtonVariant.Primary" Icon="IconName.Check" OnClick="SaveAsync" ErrorMessage="Noten blev ikke gemt">Gem</HubButton>
        }
    </Footer>
</HubDialog>

@code {
    /// <summary>One lesson in the dialog – from the calendar or the fixed timetable.</summary>
    private sealed record Entry(LessonAdjustment Target, CalendarLesson? Calendar, string? TimetableNote);

    private IReadOnlyList<Entry> entries = [];
    private string[] notes = [];
    private string[] saved = [];
    private object? shown;

    /// <summary>The schedule the lessons belong to – where the note and "Skjul" are saved.</summary>
    [Parameter, EditorRequired]
    public Guid ScheduleId { get; set; }

    /// <summary>Lessons from the school's calendar. Null or empty (and no <see cref="Timetable"/>) closes the dialog.</summary>
    [Parameter]
    public IReadOnlyList<CalendarLesson>? Lessons { get; set; }

    /// <summary>A lesson in the fixed timetable.</summary>
    [Parameter]
    public TimetableLesson? Timetable { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private bool IsDirty => notes.Where((note, i) => Clean(note) != Clean(saved[i])).Any();

    /// <summary>Hidden from this week's Monday on – older adjustments are tidied away with the change.</summary>
    private DateOnly KeepFrom => ScheduleRules.MondayOf(Clock.Today);

    /// <summary>The lesson's name – or the day, when the cell holds several lessons.</summary>
    private string Title => entries switch
    {
        [var only] => only.Target.Title,
        [var first, ..] => DanishFormat.LongDate(first.Target.Date),
        _ => "",
    };

    protected override void OnParametersSet()
    {
        // A fresh form every time other lessons are shown – not when the page refreshes around an open dialog.
        object? content = Timetable is not null ? Timetable : Lessons is { Count: > 0 } ? Lessons : null;
        if (ReferenceEquals(content, shown))
        {
            return;
        }

        shown = content;
        entries = Timetable is { } fixedLesson
            ? [new Entry(fixedLesson.Target, null, fixedLesson.TimetableNote)]
            : [.. (Lessons ?? []).Select(l => new Entry(l.Target, l, null))];
        var schedule = School.Find(ScheduleId);
        saved = [.. entries.Select(e => schedule?.FindAdjustment(e.Target)?.Note ?? "")];
        notes = [.. saved];
    }

    /// <summary>"Tirsdag 13. oktober · 08:15–09:00".</summary>
    private static string When(LessonAdjustment lesson) =>
        $"{DanishFormat.LongDate(lesson.Date)} · {DanishFormat.TimeRange(lesson.Start, lesson.End)}";

    /// <summary>"tirsdag 13. oktober".</summary>
    private static string DayText(LessonAdjustment lesson) => DanishFormat.LongDate(lesson.Date).ToLower(DanishFormat.Culture);

    private static string? Clean(string? note) => string.IsNullOrWhiteSpace(note) ? null : note.Trim();

    private static IconName IconFor(DetailSection section) => section.Label switch
    {
        "Kursus" => IconName.GraduationCap,
        "Underviser" => IconName.User,
        "Undervisere" or "Hold" => IconName.Users,
        "Lokale" => IconName.MapPin,
        _ => IconName.Info,
    };

    private Task EnterAsync() => Toasts.TryAsync(SaveAsync, "Noten blev ikke gemt", Logger);

    // The note shows under the lesson – the result is visible, so no message.
    private async Task SaveAsync()
    {
        var changed = entries
            .Select((entry, i) => (entry.Target, Note: Clean(notes[i]), Was: Clean(saved[i])))
            .Where(c => c.Note != c.Was)
            .ToList();
        if (changed.Count > 0)
        {
            var keepFrom = KeepFrom;
            await School.UpdateAsync(ScheduleId, s => changed.Aggregate(s, (current, c) => current.WithAdjustment(c.Target, a => a with { Note = c.Note }, keepFrom)));
        }

        await CloseAsync();
    }

    /// <summary>Hidden at once (with a note typed meanwhile) – "Fortryd" shows it again.</summary>
    private async Task HideAsync(Entry entry, int index)
    {
        var target = entry.Target;
        var note = Clean(notes[index]);
        var keepFrom = KeepFrom;
        await School.UpdateAsync(ScheduleId, s => s.WithAdjustment(target, a => a with { Hidden = true, Note = note }, keepFrom));
        await CloseAsync();
        Toasts.Undoable($"{target.Title} er skjult", () => School.UpdateAsync(ScheduleId, s => s.WithAdjustment(target, a => a with { Hidden = false }, keepFrom)),
            "Vis den igen med øjet øverst på siden.");
    }

    private async Task CloseAsync()
    {
        shown = null;
        entries = [];
        await OnClose.InvokeAsync();
    }

    private async Task OnOpenChanged(bool open)
    {
        if (!open)
        {
            await CloseAsync();
        }
    }
}
