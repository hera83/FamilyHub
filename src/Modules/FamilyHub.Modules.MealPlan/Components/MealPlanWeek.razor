@*
    The week's dinners as seven columns, Monday to Sunday – like the calendar's week.
    Each day shows its dishes in menu order: the main course big (with photo), a starter and a dessert as small cards
    with their course on top. Tap a dish to see it; tap an empty day – or the small "Tilføj" under the dishes – to add one.
    Swipe sideways for the previous/next week. Hold a dish and drag it to another day to move the whole dinner – starter,
    main course and dessert go together; if that day has dishes, the two days swap. The arrows change week too.
    The gestures live in MealPlanWeek.razor.js.
*@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="mp-week" @ref="root">
    @foreach (var day in Days)
    {
        var dishes = Dishes.GetValueOrDefault(day) ?? [];
        var canAdd = day >= Today && MealPlanRules.FreeCourses(dishes).Count > 0;

        <section class="mp-day @DayClass(day)" data-day="@Iso(day)">
            <div class="mp-day__head">
                <span class="mp-day__weekday">@DanishFormat.WeekdayShort(day.DayOfWeek)</span>
                <span class="mp-day__date hub-numeric">@day.Day</span>
            </div>

            <div class="mp-day__body">
                @if (Loading)
                {
                    <HubSkeleton Lines="2" />
                }
                else if (dishes.Count == 0)
                {
                    @if (canAdd)
                    {
                        <HubPressable Class="mp-day__empty" OnClick="() => OnAdd.InvokeAsync(day)" AriaLabel="@($"{DanishFormat.LongDate(day)}: tilføj aftensmad")">
                            <Icon Name="IconName.Plus" />
                            <span>Tilføj ret</span>
                        </HubPressable>
                    }
                }
                else
                {
                    @* The day's dishes together: what a drag lifts and moves. *@
                    <div class="mp-menu" data-dinner="@Iso(day)">
                    @foreach (var dish in dishes)
                    {
                        var recipe = dish.RecipeId is { } id ? FindRecipe(id) : null;
                        <HubPressable Class="mp-dish" OnClick="() => OnDishSelected.InvokeAsync(dish)" AriaLabel="@AriaLabel(dish, recipe)">
                            @if (dish.Course == DinnerCourse.Main)
                            {
                                <span class="mp-dinner" data-course="@dish.Course">
                                    @if (recipe?.ImageUrl is { } image)
                                    {
                                        <img class="mp-dinner__image" src="@image" alt="" loading="lazy" draggable="false" onerror="this.remove()" />
                                    }
                                    <span class="mp-dinner__title">@DinnerLook.Title(dish, recipe)</span>
                                    @if (recipe is not null)
                                    {
                                        @if (DinnerLook.Summary(recipe) is { Length: > 0 } summary)
                                        {
                                            <span class="mp-dinner__meta">@summary</span>
                                        }
                                    }
                                    else if (!dish.IsFromRecipeBook)
                                    {
                                        <span class="mp-dinner__meta">Egen ret</span>
                                    }
                                </span>
                            }
                            else
                            {
                                <span class="mp-dinner mp-dinner--side" data-course="@dish.Course">
                                    @if (recipe?.ImageUrl is { } image)
                                    {
                                        <img class="mp-dinner__thumb" src="@image" alt="" loading="lazy" draggable="false" onerror="this.remove()" />
                                    }
                                    <span class="mp-dinner__text">
                                        <span class="mp-dinner__course">@dish.Course.Label()</span>
                                        <span class="mp-dinner__title">@DinnerLook.Title(dish, recipe)</span>
                                    </span>
                                </span>
                            }
                        </HubPressable>
                    }
                    </div>

                    @if (canAdd)
                    {
                        <HubPressable Class="mp-day__add" OnClick="() => OnAdd.InvokeAsync(day)" AriaLabel="@($"{DanishFormat.LongDate(day)}: tilføj en ret mere")">
                            <Icon Name="IconName.Plus" />
                            <span>Tilføj</span>
                        </HubPressable>
                    }
                }
            </div>
        </section>
    }
</div>

@code {
    private ElementReference root;
    private IJSObjectReference? module;
    private IJSObjectReference? gestures;
    private DotNetObjectReference<MealPlanWeek>? self;

    /// <summary>Monday to Sunday.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<DateOnly> Days { get; set; } = [];

    /// <summary>The week's dishes by day, in menu order.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyDictionary<DateOnly, IReadOnlyList<PlannedDish>> Dishes { get; set; } = new Dictionary<DateOnly, IReadOnlyList<PlannedDish>>();

    /// <summary>Looks a recipe up in the local copy of the recipe book.</summary>
    [Parameter, EditorRequired]
    public Func<int, Recipe?> FindRecipe { get; set; } = id => null;

    [Parameter]
    public DateOnly Today { get; set; }

    /// <summary>The week's dinners are still being read – shows placeholders.</summary>
    [Parameter]
    public bool Loading { get; set; }

    /// <summary>A dish was tapped.</summary>
    [Parameter]
    public EventCallback<PlannedDish> OnDishSelected { get; set; }

    /// <summary>"Tilføj ret" on an empty day, or "Tilføj" under the dishes.</summary>
    [Parameter]
    public EventCallback<DateOnly> OnAdd { get; set; }

    /// <summary>A day's dinner was dragged to another day.</summary>
    [Parameter]
    public EventCallback<DinnerMove> OnMove { get; set; }

    /// <summary>Swiped: -1 = previous week, 1 = next week.</summary>
    [Parameter]
    public EventCallback<int> OnSwipe { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/FamilyHub.Modules.MealPlan/Components/MealPlanWeek.razor.js");
            self = DotNetObjectReference.Create(this);
            gestures = await module.InvokeAsync<IJSObjectReference>("attach", root, self);
        }
        catch (JSDisconnectedException)
        {
            // The screen went away while starting.
        }
    }

    [JSInvokable]
    public Task Swipe(int direction) => OnSwipe.InvokeAsync(Math.Sign(direction));

    [JSInvokable]
    public Task Move(string from, string to) =>
        DateOnly.TryParseExact(from, "yyyy-MM-dd", out var fromDate) && DateOnly.TryParseExact(to, "yyyy-MM-dd", out var toDate) && fromDate != toDate
            ? OnMove.InvokeAsync(new DinnerMove(fromDate, toDate))
            : Task.CompletedTask;

    private string DayClass(DateOnly day)
    {
        var css = day.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday ? "mp-day--weekend" : "";
        if (day == Today)
        {
            css += " mp-day--today";
        }
        else if (day < Today)
        {
            css += " mp-day--past";
        }

        return Dishes.ContainsKey(day) ? css + " mp-day--planned" : css;
    }

    private static string AriaLabel(PlannedDish dish, Recipe? recipe) =>
        $"{DanishFormat.LongDate(dish.Date)}, {dish.Course.Label().ToLower(DanishFormat.Culture)}: {DinnerLook.Title(dish, recipe)}";

    private static string Iso(DateOnly day) => day.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (gestures is not null)
            {
                await gestures.InvokeVoidAsync("dispose");
                await gestures.DisposeAsync();
            }

            if (module is not null)
            {
                await module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone – nothing to clean up in the browser.
        }

        self?.Dispose();
    }
}
