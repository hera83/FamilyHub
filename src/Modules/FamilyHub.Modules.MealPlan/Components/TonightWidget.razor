@implements IDisposable
@inject MealPlanService MealPlan
@inject RecipeService Recipes
@inject IHubClock Clock
@inject ILogger<TonightWidget> Logger

@*
    Home screen card: today's dinner – from 06:00 until 19:00, when the family has eaten.
    Renders nothing outside that time or when no dinner is planned, so the home screen stays calm.
*@
@if (dinner is not null && MealPlanRules.ShowTonight(TimeOnly.FromDateTime(Clock.Now.DateTime)))
{
    var recipe = dinner.RecipeId is { } id ? Recipes.Find(id) : null;
    <HubCard Title="I aften" Icon="IconName.Utensils" Href="@MealPlanModule.Path.TrimStart('/')" Class="mp-tonight">
        <div class="mp-tonight__dish">
            @if (recipe?.ImageUrl is { } image)
            {
                <img class="mp-tonight__image" src="@image" alt="" onerror="this.remove()" />
            }
            <div class="mp-tonight__text">
                <p class="mp-tonight__title">@DinnerLook.Title(dinner, recipe)</p>
                @if (recipe is not null && DinnerLook.Summary(recipe) is { Length: > 0 } summary)
                {
                    <p class="hub-muted">@summary</p>
                }
            </div>
        </div>
    </HubCard>
}

@code {
    private DateOnly day;
    private PlannedDinner? dinner;
    private IDisposable? tick;

    protected override async Task OnInitializedAsync()
    {
        MealPlan.Changed += OnMealPlanChanged;
        Recipes.Changed += OnRecipesChanged;
        tick = Clock.SubscribeMinuteTick(time => OnMinute());
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        day = Clock.Today;
        try
        {
            dinner = (await MealPlan.GetDinnersAsync(day, day.AddDays(1))).GetValueOrDefault(day);
        }
        catch (Exception ex)
        {
            // The home screen must never break because of the meal plan – the card just stays away.
            Logger.LogError(ex, "Could not read tonight's dinner");
            dinner = null;
        }
    }

    private void OnMealPlanChanged() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    private void OnRecipesChanged() => _ = InvokeAsync(StateHasChanged);

    // Every minute: a new day brings a new dinner; 06:00 and 19:00 show and hide the card.
    private void OnMinute() => _ = InvokeAsync(async () =>
    {
        if (Clock.Today != day)
        {
            await LoadAsync();
        }

        StateHasChanged();
    });

    public void Dispose()
    {
        MealPlan.Changed -= OnMealPlanChanged;
        Recipes.Changed -= OnRecipesChanged;
        tick?.Dispose();
    }
}
