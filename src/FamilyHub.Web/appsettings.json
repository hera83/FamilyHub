{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // Nøglerne ligger ukrypteret i datamappen – helt i orden på en hjemmeenhed, så ingen advarsel om det.
      "Microsoft.AspNetCore.DataProtection": "Error"
    }
  },
  "AllowedHosts": "*",

  "FamilyHub": {
    // Tidszone for ur, hilsner og nattilstand (IANA-navn).
    "TimeZone": "Europe/Copenhagen",

    // Tom = standardmappe (Windows: %LOCALAPPDATA%\FamilyHub, Linux: ~/.local/share/FamilyHub).
    // På Raspberry Pi sættes den af systemd-servicen til /var/lib/familyhub.
    "DataDirectory": "",

    // Udgangspunkt for en skærm, der aldrig er blevet indstillet. Hver skærm kan ændre det selv.
    "DeviceDefaults": {
      "KeyboardMode": "Auto",
      "Theme": "Auto",
      "NightStartHour": 21,
      "NightEndHour": 6,
      "DisplayScalePercent": 100,
      "IdleReturnMinutes": 0
    }
  }
}
