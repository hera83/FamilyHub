{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // Nøglerne ligger ukrypteret i datamappen – helt i orden på en hjemmeenhed, så ingen advarsel om det.
      "Microsoft.AspNetCore.DataProtection": "Error"
    }
  },
  "AllowedHosts": "*",

  "FamilyHub": {
    // Tidszone for ur, hilsner og nattilstand (IANA-navn).
    "TimeZone": "Europe/Copenhagen",

    // Tom = standardmappe (Windows: %LOCALAPPDATA%\FamilyHub, Linux: ~/.local/share/FamilyHub).
    // I Docker sættes den af imaget til /data (en volumen – se docker-compose.yml).
    "DataDirectory": "",

    // Udgangspunkt for en skærm, der aldrig er blevet indstillet. Hver skærm kan ændre det selv.
    "DeviceDefaults": {
      "KeyboardMode": "Auto",
      "Theme": "Auto",
      "NightStartHour": 21,
      "NightEndHour": 6,
      "DisplayScalePercent": 100,
      "IdleReturnMinutes": 0
    },

    // Madplan: familiens opskriftsbog (se docs/opskrifter-api.md).
    // Nøglen (ApiKey) er en hemmelighed: .env på serveren (RECIPES_API_KEY), dotnet user-secrets under udvikling.
    "MealPlan": {
      "Recipes": {
        "BaseUrl": "https://opskriftsbog.ramskov.pro/api/v1"
      }
    }
  }
}
