# Family Hub – indstillinger til docker compose.
#
# Kopiér filen til .env i samme mappe som docker-compose.yml, og udfyld den:
#   cp .env.example .env
#
# .env indeholder hemmeligheder. Den er i .gitignore og .dockerignore, så den hverken kommer i git eller i imaget.
# Efter en ændring:  docker compose up -d

# Netværket er fast: Family Hub svarer altid på port 8080 – køkkenskærmen åbner http://<server>:8080.
# Family Hub har endnu ingen login: alle, der kan nå porten, kan se og ændre. Begræns adgangen i
# routeren/VLAN'et (Docker går uden om ufw). Se README.md, afsnit 5.

# ---------------------------------------------------------------------------------------------------------
# Tid
# ---------------------------------------------------------------------------------------------------------

# Tidszone for ur, hilsner og nattilstand (IANA-navn).
FAMILYHUB_TIMEZONE=Europe/Copenhagen

# ---------------------------------------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------------------------------------

# Hvor husstand, nøgler og kalender gemmes. Tag backup af det hele – også mappen "keys", ellers
# kan den gemte Google-adgang ikke læses, og kontiene skal forbindes igen.
#   familyhub-data          Docker-volumen (standard, virker uden videre)
#   ./data eller /sti/…     mappe på serveren. Skal ejes af containerens bruger:  sudo chown -R 1654:1654 ./data
# Brug en lokal disk – ikke en NFS/SMB-share (SQLite-databaser tåler ikke netværksdrev).
FAMILYHUB_DATA=familyhub-data

# ---------------------------------------------------------------------------------------------------------
# Google Kalender – se docs/google-kalender.md
# ---------------------------------------------------------------------------------------------------------

# Fra nøglefilen, du downloader i trin 3 (client_secret_….json). Den ser sådan ud:
#   {"installed":{"client_id":"1234…apps.googleusercontent.com", …, "client_secret":"GOCSPX-…", …}}
# Kopiér værdien af "client_id" og "client_secret" hertil – uden anførselstegn.
# Lad dem stå tomme, indtil Google er sat op. Kalenderen viser så, hvad der mangler.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------------------------------------
# Opskrifter til madplanen – se docs/opskrifter-api.md
# ---------------------------------------------------------------------------------------------------------

# Familiens opskriftsbog. Adressen skal kun ændres, hvis opskriftsbogen flytter.
RECIPES_API_URL=https://opskriftsbog.ramskov.pro/api/v1
# Den delte nøgle (Api:SharedKey i opskriftsbogens appsettings). Tom = madplanen viser, at den mangler.
RECIPES_API_KEY=

# ---------------------------------------------------------------------------------------------------------
# Printer – se docs/printer.md
# ---------------------------------------------------------------------------------------------------------

# Familiens printserver (Print API), fx http://192.168.1.10:8080. Tom = Family Hub kan ikke printe.
PRINT_API_URL=
# En almindelig nøgle (ak_…) oprettet til Family Hub med /Keys/Create – aldrig printserverens MASTER_KEY.
PRINT_API_KEY=
# Printerens id fra printserveren. Tom = den eneste printer, printserveren kender.
PRINT_PRINTER_ID=
