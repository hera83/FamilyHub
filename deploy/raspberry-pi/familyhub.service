[Unit]
Description=Family Hub
Documentation=file:///opt/familyhub/deploy/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
User=familyhub
Group=familyhub
WorkingDirectory=/opt/familyhub
ExecStart=/opt/familyhub/FamilyHub.Web
Restart=always
RestartSec=5
TimeoutStartSec=90

# Data (household.json, nøgler, senere databaser). Oprettes og ejes af servicen.
StateDirectory=familyhub
Environment=FamilyHub__DataDirectory=/var/lib/familyhub

Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_NOLOGO=1

# Kun denne maskine kan åbne Family Hub. Skift til http://0.0.0.0:5000 for også at kunne
# åbne den fra telefoner og computere på hjemmenettet (der er endnu ingen login).
Environment=ASPNETCORE_URLS=http://localhost:5000

# Begræns hvad servicen kan røre ved.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
