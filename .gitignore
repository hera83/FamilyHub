# Family Hub

# Alle mapper i roden, der starter med punktum (.vscode, .vs, .idea, .claude …).
# Filer som .gitignore, .gitattributes, .editorconfig, .dockerignore og .env.example kommer stadig med.
/.*/
# … undtagen GitHub-opsætning (Actions, Dependabot), hvis den kommer.
!/.github/

# Kompileret output fra .NET
[Bb]in/
[Oo]bj/

# Publish-output og pakker
artifacts/
publish/
*.tar.gz
*.nupkg
*.snupkg

# Test og kodedækning
[Tt]est[Rr]esult*/
*.trx
*.coverage
coverage*.json
coverage*.xml
coverage*.info

# Byggelogfiler
*.binlog
*.log

# Brugerspecifikke IDE-filer
*.user
*.suo
*.rsuser
*.userprefs
*.DotSettings.user
*.code-workspace

# Hemmeligheder: .env med Google-nøgler m.m. Kun skabelonen .env.example hører til i git.
.env
.env.*
!.env.example
/secrets/
client_secret*.json
google-client.json
*.pfx
*.p12
*.pem
*.key

# Lokale overstyringer
*.local.json
docker-compose.override.yml
compose.override.yaml

# Lokale data (inkl. ./data, hvis den bruges som datamappe i .env)
/data/
*.db
*.db-shm
*.db-wal
*.sqlite

# UI-røgtest (Node)
node_modules/
tools/ui-smoke/shots/
tools/ui-smoke/demo-data/
tools/ui-smoke/package-lock.json

# Styresystem og editorer
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store
*.swp
*~
~$*
